{
  "manifest_version": 3,
  "name": "sitekit pulse",
  "version": "0.1.0",
  "description": "Sends browsing activity to the sitekit pulse log on this computer. Nothing is sent anywhere else.",
  "key": "",
  "incognito": "not_allowed",
  "permissions": ["tabs", "webNavigation", "nativeMessaging", "idle", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
