{
  "manifest_version": 3,
  "name": "sitekit pulse",
  "version": "0.1.0",
  "description": "Tells the local sitekit pulse daemon which pages you spend active time on, and which projects they belong to.",
  "key": "",
  "browser_specific_settings": { "gecko": { "id": "pulse@sitekit.un1tz3r0.github.io", "strict_min_version": "128.0" } },
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "permissions": ["tabs", "idle", "storage", "alarms", "scripting", "nativeMessaging"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*", "https://claude.ai/*", "https://codepen.io/*"],
  "action": { "default_title": "sitekit pulse", "default_popup": "popup.html", "default_icon": { "128": "icon.png" } },
  "icons": { "128": "icon.png" }
}
